#!/bin/sh
set -e

if command -v systemctl >/dev/null 2>&1; then
    for dir in /run/user/*; do
        [ -d "$dir" ] || continue
        uid=$(basename "$dir")
        user=$(id -nu "$uid" 2>/dev/null) || continue
        if ! runuser -u "$user" -- env XDG_RUNTIME_DIR="$dir" systemctl --user stop openskydimo.service; then
            echo "Warning: failed to stop openskydimo.service for user $user." >&2
        fi
    done

    if ! systemctl --global disable openskydimo.service; then
        echo "Warning: failed to disable openskydimo.service globally." >&2
    fi
fi

exit 0