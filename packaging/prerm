#!/bin/sh
set -e

for dir in /run/user/*; do
    [ -d "$dir" ] || continue
    uid=$(basename "$dir")
    user=$(id -nu "$uid" 2>/dev/null) || continue
    sudo -u "$user" XDG_RUNTIME_DIR="$dir" systemctl --user stop openskydimo.service 2>/dev/null || true
done

systemctl --global disable openskydimo.service 2>/dev/null || true

exit 0